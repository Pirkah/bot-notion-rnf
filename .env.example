# ==============================================================================
# FICHIER D'EXEMPLE DE CONFIGURATION DU BOT SLACK - GEMINI - NOTION
# ==============================================================================
# Instructions :
# 1. Ne mettez JAMAIS vos vraies clés dans ce fichier .env.example (il est public).
# 2. Pour tester sur votre ordinateur, faites une copie de ce fichier nommée ".env"
# 3. Pour déployer sur Render ou Railway, entrez ces variables dans l'interface web.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API (100% Gratuit sur Google AI Studio)
# ------------------------------------------------------------------------------
# Votre clé d'API Gemini (commence par "AIzaSy...")
# Obtenue sur : https://aistudio.google.com/app/apikey (sans ajouter de carte bancaire !)
GEMINI_API_KEY=AIzaSy_votre_cle_gemini_ici

# Modèle Gemini utilisé par le bot.
# Recommandé : gemini-3.8-flash (rapide, puissant, recherche web intégrée)
# Vous pouvez le changer ici l'année prochaine (ex: gemini-3.8-flash, gemini-3.5-flash-lite, etc.)
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. SLACK APP & SOCKET MODE
# ------------------------------------------------------------------------------
# Token du Bot Slack (commence par "xoxb-...")
# Trouvable sur https://api.slack.com/apps > Votre App > Install App > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-votre-token-bot-ici

# Token d'Application Slack (commence par "xapp-...")
# Trouvable sur https://api.slack.com/apps > Votre App > Basic Information > App-Level Tokens
# (Nécessite la permission connections:write)
SLACK_APP_TOKEN=xapp-votre-token-app-ici

# Signing Secret de l'application Slack
# Trouvable sur https://api.slack.com/apps > Votre App > Basic Information > App Credentials
SLACK_SIGNING_SECRET=votre_signing_secret_ici

# ------------------------------------------------------------------------------
# 3. NOTION INTEGRATION
# ------------------------------------------------------------------------------
# Clé secrète de votre intégration Notion (commence par "secret_..." ou "ntn_...")
# Obtenue sur : https://www.notion.so/my-integrations
# IMPORTANT : Pensez à inviter/connecter l'intégration sur votre page Notion principale !
NOTION_API_KEY=ntn_votre_cle_notion_ici

# (Optionnel) ID de la page racine ou de la base de données principale du projet
# Si vous le laissez vide, le bot cherchera dans toutes les pages partagées avec lui.
# Exemple d'ID extrait de l'URL : si l'URL de votre page Notion est :
# https://notion.so/Projet-GEA-1234567890abcdef1234567890abcdef
# L'ID est la suite de 32 caractères : 1234567890abcdef1234567890abcdef
NOTION_ROOT_PAGE_ID=

# ------------------------------------------------------------------------------
# 4. SERVEUR & HÉBERGEMENT
# ------------------------------------------------------------------------------
# Port utilisé pour le mini-serveur de santé (nécessaire pour l'hébergement gratuit Render)
PORT=3000
